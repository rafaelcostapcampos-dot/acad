{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "acad-preview",
  "main": "./cloudflare/worker.js",
  "compatibility_date": "2026-10-28",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/acad-api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "acad-treinos-db",
      "database_id": "15f0fb46-6317-4467-a6bf-54b83a4f2a9a"
    }
  ]
}
