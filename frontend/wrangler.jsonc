{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "acad-preview",
  "main": "./cloudflare/worker.js",
  "compatibility_date": "2026-10-28",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/acad-api/*"
    ]
  }
}
